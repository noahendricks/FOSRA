{
  "name": "fosra-tui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build ./src/index.tsx --compile --target=bun-linux-x64 --outfile=dist/fosra-tui",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev:test": "bun run --watch src/dev.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.1.96",
    "@opentui/solid": "0.1.96",
    "@solid-primitives/event-bus": "^1.1.3",
    "@solid-primitives/scheduled": "^1.5.3",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.1",
    "diff": "^8.0.4",
    "fuzzysort": "^3.1.0",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.6",
    "remeda": "^2.33.7",
    "solid-js": "^1.9.12",
    "strip-ansi": "^7.2.0",
    "tslog": "^4.10.2",
    "ulidx": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.95.0",
    "@types/bun": "^1.3.11",
    "@types/diff": "^8.0.0",
    "@vtsls/language-server": "^0.3.0",
    "typescript": "^6.0.2"
  }
}
