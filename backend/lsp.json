{
	"servers": {
		"basedpyright": {
			"command": "basedpyright-langserver",
			"args": ["--stdio"],
			"fileTypes": [".py", ".pyi"],
			"rootMarkers": ["pyproject.toml", "requirements.txt"],
			"settings": {
				"basedpyright": {
					"analysis": {
						"autoSearchPaths": true,
						"diagnosticMode": "workspaceFiles",
						"useLibraryCodeForTypes": true,
						"typeCheckingMode": "basic"
					}
				}
			}
		}
	}
}